{
  "name": "traderos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TraderOS \u2014 professional multi-workspace trading terminal",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.verify/smoke.mjs --log-level=error && node .verify/smoke.mjs",
    "verify": "tsc --noEmit && npm run smoke && vite build"
  },
  "dependencies": {
    "lightweight-charts": "4.2.3",
    "lucide-react": "^0.469.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
